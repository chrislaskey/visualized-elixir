<Layouts.app flash={@flash}>
  <.h1>Supervisors</.h1>

  <div
    id="supervisors-react-flow"
    phx-hook=".ReactFlowSupervisors"
    phx-update="ignore"
    class="mt-4 h-[600px] max-h-[90vh] w-full rounded-box border border-base-300 bg-base-200/60"
  >
  </div>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".ReactFlowSupervisors" extension="jsx">
    import {useCallback, useEffect, useMemo, useRef, useState} from "react"
    import {createRoot} from "react-dom/client"
    import {ReactFlowContext, supervisionNodeTypes} from "@/js/process_card"
    import {
      Background,
      Controls,
      MiniMap,
      ReactFlow,
      ReactFlowProvider,
      addEdge,
      applyEdgeChanges,
      applyNodeChanges,
    } from "@xyflow/react"

    // Data

    function toServerDataNode(node) {
      const out = {
        id: node.id,
        position: {x: Math.round(node.position.x), y: Math.round(node.position.y)},
        data: node.data,
      }
      if (node.type) out.type = node.type
      return out
    }

    function toServerDataEdge(edge) {
      const out = {id: edge.id, source: edge.source, target: edge.target}
      if (edge.sourceHandle) out.sourceHandle = edge.sourceHandle
      if (edge.targetHandle) out.targetHandle = edge.targetHandle
      return out
    }

    function toServerData(nodes, edges) {
      return {nodes: nodes.map(toServerDataNode), edges: edges.map(toServerDataEdge)}
    }

    function encodeForComparison(value) {
      if (Array.isArray(value)) return `[${value.map(encodeForComparison).join(",")}]`
      if (value && typeof value === "object") {
        return `{${Object.keys(value)
          .sort()
          .map(key => `${JSON.stringify(key)}:${encodeForComparison(value[key])}`)
          .join(",")}}`
      }
      return JSON.stringify(value)
    }

    function mergeNodes(current, incoming) {
      const byId = new Map(current.map(node => [node.id, node]))

      return incoming.map(node => {
        const local = byId.get(node.id)
        if (!local) return node
        return {...local, ...node, position: local.dragging ? local.position : node.position}
      })
    }

    function mergeEdges(current, incoming) {
      const byId = new Map(current.map(edge => [edge.id, edge]))

      return incoming.map(edge => {
        const local = byId.get(edge.id)
        return local ? {...local, ...edge} : edge
      })
    }

    // Adding children

    const CHILD_OFFSET_Y = 260
    const SIBLING_OFFSET_X = 320

    const KIND_PREFIX = {supervisor: "sup"}
    const KIND_LABEL = {supervisor: "Supervisor"}

    function nextNodeNumber(nodes) {
      const numbers = nodes.map(node => Number(node.id.match(/-(\d+)$/)?.[1] ?? 0))
      return Math.max(1, ...numbers) + 1
    }

    function childPosition(parent, siblings) {
      if (siblings.length === 0) return {x: parent.position.x, y: parent.position.y + CHILD_OFFSET_Y}

      const rightmost = Math.max(...siblings.map(node => node.position.x))
      return {x: rightmost + SIBLING_OFFSET_X, y: parent.position.y + CHILD_OFFSET_Y}
    }

    function buildChild(kind, parent, nodes, edges) {
      const number = nextNodeNumber(nodes)
      const id = `${KIND_PREFIX[kind]}-${number}`
      const siblingIds = new Set(edges.filter(edge => edge.source === parent.id).map(edge => edge.target))
      const siblings = nodes.filter(node => siblingIds.has(node.id))

      const node = {
        id,
        type: kind,
        position: childPosition(parent, siblings),
        data: {label: `${KIND_LABEL[kind]} ${number}`, config: {strategy: "one_for_one"}},
      }
      const edge = {id: `${parent.id}-${id}`, source: parent.id, target: id}

      return {node, edge}
    }

    // Instance

    function ReactFlowInstance({data, browserInstanceId, pushEvent}) {
      const [nodes, setNodes] = useState(() => data.nodes)
      const [edges, setEdges] = useState(() => data.edges)
      const lastSynced = useRef(encodeForComparison(toServerData(data.nodes, data.edges)))

      // The latest nodes and edges, so actions handed to the nodes
      // through context stay stable across renders.
      const latest = useRef({nodes, edges})
      latest.current = {nodes, edges}

      useEffect(() => {
        if (data.client_id === browserInstanceId) return

        lastSynced.current = encodeForComparison(toServerData(data.nodes, data.edges))
        setNodes(current => mergeNodes(current, data.nodes))
        setEdges(current => mergeEdges(current, data.edges))
      }, [data, browserInstanceId])

      useEffect(() => {
        if (nodes.some(node => node.dragging)) return

        const next = toServerData(nodes, edges)
        const key = encodeForComparison(next)
        if (key === lastSynced.current) return

        lastSynced.current = key
        pushEvent("data", {...next, client_id: browserInstanceId})
      }, [nodes, edges, browserInstanceId, pushEvent])

      // Future: server status will be passed in separately and layer on at render time so it never enters `nodes` state and
      // therefore never enters the snapshot. Custom nodes read it as data.status.
      const statuses = {}
      const displayNodes = useMemo(
        () => nodes.map(node => ({...node, data: {...node.data, status: statuses[node.id]}})),
        [nodes, statuses],
      )

      const onNodesChange = useCallback(changes => setNodes(current => applyNodeChanges(changes, current)), [])
      const onEdgesChange = useCallback(changes => setEdges(current => applyEdgeChanges(changes, current)), [])
      const onConnect = useCallback(connection => setEdges(current => addEdge(connection, current)), [])

      const addChild = useCallback((parentId, kind) => {
        if (!(kind in KIND_PREFIX)) return

        const {nodes, edges} = latest.current
        const parent = nodes.find(node => node.id === parentId)
        if (!parent) return

        const {node, edge} = buildChild(kind, parent, nodes, edges)
        setNodes(current => [...current, node])
        setEdges(current => [...current, edge])
      }, [])

      const context = useMemo(() => ({addChild}), [addChild])

      return (
        <ReactFlowContext.Provider value={context}>
          <ReactFlow
            nodes={displayNodes}
            edges={edges}
            nodeTypes={supervisionNodeTypes}
            onNodesChange={onNodesChange}
            onEdgesChange={onEdgesChange}
            onConnect={onConnect}
            deleteKeyCode={["Backspace", "Delete"]}
            fitView
            fitViewOptions={{padding: 0.3, maxZoom: 1}}
            minZoom={0.3}
          >
            <Background />
            <Controls />
            <MiniMap pannable zoomable />
          </ReactFlow>
        </ReactFlowContext.Provider>
      )
    }

    // Instance lifecycle

    function mount(el, {browserInstanceId, pushEvent, data}) {
      const root = createRoot(el)
      let current = {data}

      const render = () =>
        root.render(
          <ReactFlowProvider>
            <ReactFlowInstance browserInstanceId={browserInstanceId} pushEvent={pushEvent} data={current.data} />
          </ReactFlowProvider>
        )

      render()

      return {
        setData: data => {
          current = {...current, data}
          render()
        },
        unmount: () => root.unmount()
      }
    }

    // LiveView Hook

    export default {
      mounted() {
        this.browserInstanceId = crypto.randomUUID()

        const pushEvent = (event, payload) => this.pushEvent(event, payload)

        this.handleEvent("data", data => {
          if (this.reactFlowInstance) {
            this.reactFlowInstance.setData(data)
          } else {
            this.reactFlowInstance = mount(this.el, {browserInstanceId: this.browserInstanceId, pushEvent, data})
          }
        })
      },

      destroyed() {
        this.reactFlowInstance?.unmount()
      }
    }
  </script>
</Layouts.app>
